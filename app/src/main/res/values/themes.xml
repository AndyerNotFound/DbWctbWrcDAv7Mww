<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Neko" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neko_primary</item>
        <item name="colorOnPrimary">@color/neko_on_primary</item>
        <item name="colorPrimaryContainer">@color/neko_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/neko_on_primary_container</item>
        <item name="colorSecondary">@color/neko_secondary</item>
        <item name="colorOnSecondary">@color/neko_on_secondary</item>
        <item name="colorSecondaryContainer">@color/neko_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/neko_on_secondary_container</item>
        <item name="colorTertiary">@color/neko_tertiary</item>
        <item name="colorOnTertiary">@color/neko_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/neko_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/neko_on_tertiary_container</item>
        <item name="colorError">@color/neko_error</item>
        <item name="colorOnError">@color/neko_on_error</item>
        <item name="colorErrorContainer">@color/neko_error_container</item>
        <item name="colorOnErrorContainer">@color/neko_on_error_container</item>
        <item name="android:colorBackground">@color/neko_background</item>
        <item name="colorOnBackground">@color/neko_on_background</item>
        <item name="colorSurface">@color/neko_surface</item>
        <item name="colorOnSurface">@color/neko_on_surface</item>
        <item name="colorSurfaceVariant">@color/neko_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/neko_on_surface_variant</item>
        <item name="colorOutline">@color/neko_outline</item>
        <item name="colorOutlineVariant">@color/neko_outline_variant</item>
        <item name="colorSurfaceInverse">@color/neko_surface_inverse</item>
        <item name="colorOnSurfaceInverse">@color/neko_on_surface_inverse</item>
        <item name="colorPrimaryInverse">@color/neko_primary_inverse</item>
        <item name="colorSurfaceDim">@color/neko_surface_dim</item>
        <item name="colorSurfaceBright">@color/neko_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/neko_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/neko_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/neko_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/neko_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/neko_surface_container_highest</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="Theme.Neko.FullscreenInput" parent="Theme.Material3Expressive.DayNight.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Neko.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Neko.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Neko.Code" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.Neko.EffortLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">8.5sp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.Neko.Number" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ShapeAppearanceOverlay.Neko.InputDock" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Neko.SheetCard" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.Neko.WavyProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">5dp</item>
        <item name="trackCornerRadius">50%</item>
        <item name="waveAmplitude">2.5dp</item>
        <item name="wavelength">40dp</item>
        <item name="wavelengthIndeterminate">22dp</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceContainerHighest</item>
    </style>

    <style name="Widget.Neko.ThinProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">50%</item>
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorSurfaceContainerHighest</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="Widget.Neko.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipIconSize">16dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">10dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Neko.Chip</item>
    </style>

    <style name="ShapeAppearanceOverlay.Neko.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- The removable chip that marks the message currently being edited in the composer. -->
    <style name="Widget.Neko.Chip.Input" parent="Widget.Material3.Chip.Input">
        <item name="android:textSize">12sp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="chipIconSize">16dp</item>
        <item name="closeIconSize">16dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="textStartPadding">6dp</item>
        <item name="textEndPadding">4dp</item>
        <item name="iconStartPadding">2dp</item>
        <item name="iconEndPadding">0dp</item>
        <item name="closeIconStartPadding">2dp</item>
        <item name="closeIconEndPadding">2dp</item>
        <item name="android:checkable">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Neko.Chip</item>
        <item name="chipBackgroundColor">?attr/colorTertiaryContainer</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
        <item name="chipIconTint">?attr/colorOnTertiaryContainer</item>
        <item name="closeIconTint">?attr/colorOnTertiaryContainer</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <style name="Widget.Neko.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

</resources>
