<?xml version="1.0" encoding="utf-8"?>
<!--
  A user message that carries an image: the same button shaped surface as a text bubble, with the
  thumbnail dropped into the rich media slot above the caption.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="52dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="6dp">

    <dev.neko.chatdemo.ui.BubbleButton
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        app:bubbleContainerColor="?attr/colorPrimaryContainer"
        app:bubbleCornerSize="20dp"
        app:bubbleSharpCorner="bottomRight"
        app:bubbleTailSize="5dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="5dp"
            android:paddingTop="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp">

            <FrameLayout
                android:id="@+id/message_media"
                android:layout_width="230dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_thumb"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_image"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/neko_scrim_soft"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="layout-sketch.png"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="#FFFFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/message_text"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:paddingStart="9dp"
                android:paddingTop="8dp"
                android:paddingEnd="9dp"
                android:paddingBottom="6dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
    </dev.neko.chatdemo.ui.BubbleButton>

    <TextView
        android:id="@+id/message_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="6dp"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
