<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="5dp"
    android:paddingEnd="24dp"
    android:paddingBottom="7dp">

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_avatar">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_auto_awesome"
            app:tint="?attr/colorOnPrimaryContainer" />
    </FrameLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/suggestion_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        app:chipSpacingHorizontal="6dp"
        app:chipSpacingVertical="6dp"
        app:singleLine="false">

        <com.google.android.material.chip.Chip
            style="@style/Widget.Neko.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/suggestion_summarize"
            app:chipIcon="@drawable/ic_auto_awesome" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Neko.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/suggestion_review_dock"
            app:chipIcon="@drawable/ic_animation" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.Neko.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/suggestion_devlog"
            app:chipIcon="@drawable/ic_draft" />
    </com.google.android.material.chip.ChipGroup>
</LinearLayout>
