<?xml version="1.0" encoding="utf-8"?>
<!--
  Sidebar panel: a collapsing title, the quick entries pinned inside the app bar (noScroll), and the
  history as the scrolling child so it drives the collapse. A day group opens inside its own card
  in that history, so opening one never leaves this page.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebar_start_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/sidebar_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/sidebar_collapsing"
            android:layout_width="match_parent"
            android:layout_height="112dp"
            app:collapsedTitleGravity="center_vertical|start"
            app:contentScrim="?attr/colorSurface"
            app:expandedTitleGravity="bottom|start"
            app:expandedTitleMarginBottom="14dp"
            app:expandedTitleMarginStart="20dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:title="@string/sidebar_title"
            app:titleEnabled="true">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/sidebar_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:navigationContentDescription="@string/sidebar_collapse"
                app:navigationIcon="@drawable/ic_keyboard_double_arrow_left"
                app:navigationIconTint="?attr/colorOnSurface"
                app:titleMarginStart="56dp" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <!-- Quick entries: pinned under the toolbar, one per row, all the same width. -->
        <LinearLayout
            android:id="@+id/sidebar_functions_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:paddingEnd="16dp"
            app:layout_scrollFlags="noScroll">

            <TextView
                android:id="@+id/sidebar_functions_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="4dp"
                android:paddingTop="2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:text="@string/sidebar_quick_actions"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_function_new"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="start|center_vertical"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="@string/sidebar_new_session"
                android:textAlignment="viewStart"
                android:textSize="13sp"
                app:icon="@drawable/ic_add_comment"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_function_search"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="start|center_vertical"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="@string/sidebar_search"
                android:textAlignment="viewStart"
                android:textSize="13sp"
                app:icon="@drawable/ic_search"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sidebar_function_folders"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:gravity="start|center_vertical"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:text="@string/sidebar_folders"
                android:textAlignment="viewStart"
                android:textSize="13sp"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconSize="16dp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- History: the scrolling child, so dragging it collapses the title. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sidebar_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/sidebar_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="112dp" />
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
