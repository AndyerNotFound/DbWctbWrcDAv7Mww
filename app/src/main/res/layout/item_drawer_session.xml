<?xml version="1.0" encoding="utf-8"?>
<!--
  One session row, nested under its day group. It lives inside the group card, indented from the
  header, so the hierarchy is visible without leaving the panel. Only the active row is filled; the
  rest stay borderless so the indented list reads as quiet children of the group.
-->
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="?attr/borderlessButtonStyle"
    android:layout_width="match_parent"
    android:layout_height="38dp"
    android:gravity="start|center_vertical"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:maxWidth="1000dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:textAlignment="viewStart"
    android:textColor="@color/sidebar_item_text"
    android:textSize="13sp"
    app:backgroundTint="@color/sidebar_item_bg"
    app:icon="@drawable/ic_chat_bubble"
    app:iconGravity="textStart"
    app:iconPadding="10dp"
    app:iconSize="16dp"
    app:iconTint="@color/sidebar_item_text" />
